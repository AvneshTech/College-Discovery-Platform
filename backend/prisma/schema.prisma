// ============================================================================
// CollegeEdge — Production Prisma Schema
// Upgrades over the original:
//  - Role-based access control (Student / Admin)
//  - Refresh token storage (rotation + revocation)
//  - Rich College model (logo, images, NIRF, NAAC, placements) + indexes
//  - Reviews & Ratings (separate from aggregate college.rating)
//  - Scholarships + Admission Deadlines
//  - Notifications (for Socket.io real-time features)
//  - Predictor history (for "Predictor Usage" dashboard analytics)
//  - Soft-delete friendly flags, audit timestamps everywhere
//  - @@index on every column used in WHERE/ORDER BY in the API
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
}

enum DiscussionStatus {
  OPEN
  CLOSED
  FLAGGED
}

enum NotificationType {
  REPLY
  SAVE_PRICE_DROP
  DEADLINE_REMINDER
  SYSTEM
}

// ─────────────────────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(STUDENT)
  avatarUrl     String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)

  // Preference fields used by the recommendation engine
  preferredBranches String[] @default([])
  preferredCities   String[] @default([])
  budgetMaxFees     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedColleges    SavedCollege[]
  discussions      Discussion[]
  answers          Answer[]
  reviews          Review[]
  refreshTokens    RefreshToken[]
  predictorRuns    PredictorRun[]
  notifications    Notification[]
  collegesCreated  College[]        @relation("CollegeCreatedBy")

  @@index([role])
  @@index([email])
}

// Rotating refresh tokens — store a HASH, never the raw token.
model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  replacedBy String?
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────
// COLLEGES
// ─────────────────────────────────────────────────────────────────────────

model College {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  city        String
  state       String?
  type        String? // Government / Private / Deemed
  logoUrl     String?
  bannerUrl   String?
  gallery     String[] @default([])

  rating        Float   @default(0) // aggregate, denormalized from Review
  reviewCount   Int     @default(0)
  nirfRank      Int?
  naacGrade     String? // "A++", "A+", "A", "B++"...

  fees           Int?    // annual, in INR, for filtering/sorting numerically
  feesDisplay    String? // "₹2.5L / yr" formatted label
  avgPackage     Int?
  highestPackage Int?
  placementRate  Float?  // 0-100

  courses     String[] @default([]) // ["B.Tech", "M.Tech", "MBA"]
  branches    String[] @default([]) // ["CSE", "ECE", "Mechanical"]
  overview    String?  @db.Text
  website     String?
  established Int?

  isPublished Boolean  @default(true)

  createdById Int?
  createdBy   User?    @relation("CollegeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  savedBy     SavedCollege[]
  reviews     Review[]
  deadlines   AdmissionDeadline[]
  cutoffs     CutoffRecord[]
  scholarships CollegeScholarship[]

  // Composite + single-column indexes matching real query patterns:
  // search by name/city, filter by rating/fees/rank, sort by rating desc.
  @@index([city])
  @@index([rating])
  @@index([fees])
  @@index([nirfRank])
  @@index([isPublished])
  @@index([city, rating])
}

model SavedCollege {
  id        Int      @id @default(autoincrement())
  userId    Int
  collegeId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}

// Historical cutoff data — what the smarter predictor trains/scores against.
model CutoffRecord {
  id         Int     @id @default(autoincrement())
  collegeId  Int
  college    College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  exam       String  // "JEE Main", "JEE Advanced", "BITSAT", ...
  branch     String
  category   String  // "General", "OBC", "SC", "ST", "EWS"
  year       Int
  closingRank Int
  openingRank Int?

  @@index([exam, branch, category])
  @@index([collegeId])
}

model PredictorRun {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam      String
  rank      Int
  category  String?
  branchPref String?
  resultsJson Json    // snapshot of top recommendations for analytics/history
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────────────────────────────────

model Review {
  id        Int      @id @default(autoincrement())
  collegeId Int
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Float    // 1-5
  title     String?
  body      String   @db.Text
  isApproved Boolean @default(true) // for moderation
  createdAt DateTime @default(now())

  @@unique([userId, collegeId]) // one review per user per college
  @@index([collegeId])
}

// ─────────────────────────────────────────────────────────────────────────
// SCHOLARSHIPS & DEADLINES
// ─────────────────────────────────────────────────────────────────────────

model Scholarship {
  id          Int     @id @default(autoincrement())
  name        String
  provider    String
  amount      String
  eligibility String  @db.Text
  applyUrl    String?
  deadline    DateTime?
  colleges    CollegeScholarship[]

  @@index([deadline])
}

model CollegeScholarship {
  id            Int          @id @default(autoincrement())
  collegeId     Int
  college       College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  scholarshipId Int
  scholarship   Scholarship  @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([collegeId, scholarshipId])
}

model AdmissionDeadline {
  id        Int      @id @default(autoincrement())
  collegeId Int
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  title     String   // "JEE Counselling Round 1"
  date      DateTime
  notes     String?

  @@index([date])
  @@index([collegeId])
}

// ─────────────────────────────────────────────────────────────────────────
// DISCUSSIONS / FORUM
// ─────────────────────────────────────────────────────────────────────────

model Discussion {
  id        Int               @id @default(autoincrement())
  title     String
  body      String            @db.Text
  status    DiscussionStatus  @default(OPEN)
  authorId  Int
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers   Answer[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Answer {
  id           Int        @id @default(autoincrement())
  body         String     @db.Text
  authorId     Int
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discussionId Int
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  isFlagged    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([discussionId])
}

// ─────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS (Socket.io real-time layer persists here too)
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  link      String?
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([userId, isRead])
}
