generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  password          String
  role              Role      @default(STUDENT)
  avatarUrl         String?
  avatarPublicId    String?
  bio               String?
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  preferredBranches String[]  @default([])
  preferredCities   String[]  @default([])
  budgetMaxFees     Int?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  answers          Answer[]
  collegesCreated  College[]        @relation("CollegeCreatedBy")
  collegeViews     CollegeView[]
  contactInquiries ContactInquiry[]
  discussions      Discussion[]
  notifications    Notification[]
  predictorRuns    PredictorRun[]
  refreshTokens    RefreshToken[]
  reviews          Review[]
  savedColleges    SavedCollege[]
  uploads          Upload[]

  @@index([role])
  @@index([email])
}

model College {
  id Int @id @default(autoincrement())

  // Basic Info
  name    String
  slug    String  @unique
  city    String
  state   String?
  country String? @default("India")
  type    String?

  // Contact
  email String?
  phone String?

  // Branding & Media
  logoUrl      String?
  logoPublicId String?

  bannerUrl      String?
  bannerPublicId String?

  // Gallery (unified — array of { url, publicId, caption })
  gallery Json?

  // Ratings
  rating      Float @default(0)
  reviewCount Int   @default(0)

  // Rankings
  nirfRank  Int?
  naacGrade String?

  // Placements
  avgPackage     Int?
  highestPackage Int?
  placementRate  Float?

  // Fees
  fees        Int?
  feesDisplay String?

  // Academic
  courses  String[] @default([])
  branches String[] @default([])

  // Details
  overview    String?
  website     String?
  established Int?

  // SEO
  metaTitle       String?
  metaDescription String?

  // Status
  isPublished Boolean @default(true)
  isFeatured  Boolean @default(false)
  isVerified  Boolean @default(false)

  // Analytics
  viewsCount   Int @default(0)
  saveCount    Int @default(0)
  compareCount Int @default(0)

  // Ownership
  createdById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdBy User? @relation("CollegeCreatedBy", fields: [createdById], references: [id])

  deadlines    AdmissionDeadline[]
  scholarships CollegeScholarship[]
  cutoffs      CutoffRecord[]
  reviews      Review[]
  savedBy      SavedCollege[]
  views        CollegeView[]

  @@index([city])
  @@index([state])
  @@index([rating])
  @@index([fees])
  @@index([nirfRank])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([isVerified])
  @@index([viewsCount])
  @@index([saveCount])
  @@index([compareCount])
  @@index([city, rating])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  replacedBy String?
  createdAt  DateTime @default(now())
  userAgent  String?
  ip         String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SavedCollege {
  id        Int      @id @default(autoincrement())
  userId    Int
  collegeId Int
  createdAt DateTime @default(now())
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}

model CutoffRecord {
  id          Int     @id @default(autoincrement())
  collegeId   Int
  exam        String
  branch      String
  category    String
  year        Int
  closingRank Int
  openingRank Int?
  college     College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([exam, branch, category])
  @@index([collegeId])
}

model PredictorRun {
  id          Int      @id @default(autoincrement())
  userId      Int
  exam        String
  rank        Int
  category    String?
  branchPref  String?
  resultsJson Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id         Int      @id @default(autoincrement())
  collegeId  Int
  userId     Int
  rating     Float
  title      String?
  body       String
  likesCount Int      @default(0)
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  college    College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([collegeId])
}

model Scholarship {
  id          Int                  @id @default(autoincrement())
  name        String
  provider    String
  amount      String
  eligibility String
  applyUrl    String?
  deadline    DateTime?
  colleges    CollegeScholarship[]

  @@index([deadline])
}

model CollegeScholarship {
  id            Int         @id @default(autoincrement())
  collegeId     Int
  scholarshipId Int
  college       College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([collegeId, scholarshipId])
}

model AdmissionDeadline {
  id        Int      @id @default(autoincrement())
  collegeId Int
  title     String
  date      DateTime
  notes     String?
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([collegeId])
}

model Discussion {
  id         Int              @id @default(autoincrement())
  title      String
  body       String
  status     DiscussionStatus @default(OPEN)
  tags       String[]         @default([])
  viewsCount Int              @default(0)
  authorId   Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  answers    Answer[]
  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model Answer {
  id           Int        @id @default(autoincrement())
  body         String
  authorId     Int
  discussionId Int
  isFlagged    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ---------------------------------------------
// New models (Cloudinary uploads, analytics, contact)
// ---------------------------------------------

model Upload {
  id         Int      @id @default(autoincrement())
  publicId   String   @unique
  url        String
  folder     String
  uploadedBy Int?
  createdAt  DateTime @default(now())

  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([folder])
}

model CollegeView {
  id        Int      @id @default(autoincrement())
  collegeId Int
  userId    Int?
  viewedAt  DateTime @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([viewedAt])
}

model ContactInquiry {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  subject    String
  message    String
  isResolved Boolean  @default(false)
  userId     Int?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isResolved])
  @@index([createdAt])
}

enum Role {
  STUDENT
  ADMIN
}

enum DiscussionStatus {
  OPEN
  CLOSED
  FLAGGED
}

enum NotificationType {
  REPLY
  SAVE_PRICE_DROP
  DEADLINE_REMINDER
  SYSTEM
}
