generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int            @id @default(autoincrement())
  name              String
  email             String         @unique
  password          String
  role              Role           @default(STUDENT)
  avatarUrl         String?
  isActive          Boolean        @default(true)
  emailVerified     Boolean        @default(false)
  preferredBranches String[]       @default([])
  preferredCities   String[]       @default([])
  budgetMaxFees     Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  answers           Answer[]
  collegesCreated   College[]      @relation("CollegeCreatedBy")
  discussions       Discussion[]
  notifications     Notification[]
  predictorRuns     PredictorRun[]
  refreshTokens     RefreshToken[]
  reviews           Review[]
  savedColleges     SavedCollege[]

  @@index([role])
  @@index([email])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  replacedBy String?
  createdAt  DateTime @default(now())
  userAgent  String?
  ip         String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model College {
  id             Int                  @id @default(autoincrement())
  name           String
  slug           String               @unique
  city           String
  state          String?
  type           String?
  logoUrl        String?
  bannerUrl      String?
  gallery        String[]             @default([])
  rating         Float                @default(0)
  reviewCount    Int                  @default(0)
  nirfRank       Int?
  naacGrade      String?
  fees           Int?
  feesDisplay    String?
  avgPackage     Int?
  highestPackage Int?
  placementRate  Float?
  courses        String[]             @default([])
  branches       String[]             @default([])
  overview       String?
  website        String?
  established    Int?
  isPublished    Boolean              @default(true)
  createdById    Int?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deadlines      AdmissionDeadline[]
  createdBy      User?                @relation("CollegeCreatedBy", fields: [createdById], references: [id])
  scholarships   CollegeScholarship[]
  cutoffs        CutoffRecord[]
  reviews        Review[]
  savedBy        SavedCollege[]

  @@index([city])
  @@index([rating])
  @@index([fees])
  @@index([nirfRank])
  @@index([isPublished])
  @@index([city, rating])
}

model SavedCollege {
  id        Int      @id @default(autoincrement())
  userId    Int
  collegeId Int
  createdAt DateTime @default(now())
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}

model CutoffRecord {
  id          Int     @id @default(autoincrement())
  collegeId   Int
  exam        String
  branch      String
  category    String
  year        Int
  closingRank Int
  openingRank Int?
  college     College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([exam, branch, category])
  @@index([collegeId])
}

model PredictorRun {
  id          Int      @id @default(autoincrement())
  userId      Int
  exam        String
  rank        Int
  category    String?
  branchPref  String?
  resultsJson Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id         Int      @id @default(autoincrement())
  collegeId  Int
  userId     Int
  rating     Float
  title      String?
  body       String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  college    College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([collegeId])
}

model Scholarship {
  id          Int                  @id @default(autoincrement())
  name        String
  provider    String
  amount      String
  eligibility String
  applyUrl    String?
  deadline    DateTime?
  colleges    CollegeScholarship[]

  @@index([deadline])
}

model CollegeScholarship {
  id            Int         @id @default(autoincrement())
  collegeId     Int
  scholarshipId Int
  college       College     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([collegeId, scholarshipId])
}

model AdmissionDeadline {
  id        Int      @id @default(autoincrement())
  collegeId Int
  title     String
  date      DateTime
  notes     String?
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([collegeId])
}

model Discussion {
  id        Int              @id @default(autoincrement())
  title     String
  body      String
  status    DiscussionStatus @default(OPEN)
  authorId  Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  answers   Answer[]
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model Answer {
  id           Int        @id @default(autoincrement())
  body         String
  authorId     Int
  discussionId Int
  isFlagged    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

enum Role {
  STUDENT
  ADMIN
}

enum DiscussionStatus {
  OPEN
  CLOSED
  FLAGGED
}

enum NotificationType {
  REPLY
  SAVE_PRICE_DROP
  DEADLINE_REMINDER
  SYSTEM
}
